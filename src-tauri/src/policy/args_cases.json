  "rules": [
    {
      "_comment": "옛 모양 사용자 규칙은 예전 의미 그대로 — 인자를 보지 않는다(몰래 좁히지 않는다).",
      "rules": [{ "exec": "git", "subcommands": ["branch"] }, { "exec": "df", "subcommands": [] }],
      "cases": [
        ["git branch -D main", true],
        ["git branch newbranch", true],
        ["git status", false],
        ["df -h --output=x", true],
        ["git 'branch'", false]
      ]
    },
    {
      "_comment": "deny_flags — 묶인 짧은 플래그·값 붙은 긴 플래그·줄임·접두 와일드카드·따옴표.",
      "rules": [{ "exec": "journalctl", "subcommands": [], "deny_flags": ["-f", "--follow", "--vacuum-*"] }],
      "cases": [
        ["journalctl -u nginx", true],
        ["journalctl", true],
        ["journalctl -fu nginx", false],
        ["journalctl -xef", false],
        ["journalctl --follow", false],
        ["journalctl --follow=yes", false],
        ["journalctl --foll", false],
        ["journalctl --fields", true],
        ["journalctl --vacuum-time=1s", false],
        ["journalctl --vacuum", false],
        ["journalctl '-f'", false],
        ["journalctl -F", true],
        ["journalctl -- -f", true]
      ]
    },
    {
      "_comment": "형식이 틀린 금지 항목이 있으면 그 규칙은 통째로 매칭되지 않는다(안전한 쪽).",
      "rules": [{ "exec": "journalctl", "subcommands": [], "deny_flags": ["follow"] }],
      "cases": [["journalctl", false], ["journalctl -u x", false]]
    },
    {
      "rules": [{ "exec": "journalctl", "subcommands": [], "deny_flags": ["--vac*uum"] }],
      "cases": [["journalctl", false]]
    },
    {
      "_comment": "allow_flags + max_args — 목록형 플래그만, 이름 인자 없음. 묶음은 글자마다.",
      "rules": [{ "exec": "git", "subcommands": ["branch"], "allow_flags": ["-a", "-v", "--sort"], "max_args": 0 }],
      "cases": [
        ["git branch", true],
        ["git branch -a", true],
        ["git branch -av", true],
        ["git branch -vv", true],
        ["git branch --sort=-committerdate", true],
        ["git branch -D x", false],
        ["git branch -aD", false],
        ["git branch --so", false],
        ["git branch x", false],
        ["git branch ''", false],
        ["git branch -- x", false],
        ["git status", false]
      ]
    },
    {
      "_comment": "first_arg — 서브커맨드 뒤 첫 인자만 본다(그 뒤는 자유). 와일드카드는 끝의 *.",
      "rules": [
        { "exec": "ip", "subcommands": ["addr"], "first_arg": ["show", "list"] },
        { "exec": "date", "subcommands": [], "first_arg": ["+*"], "max_args": 1 }
      ],
      "cases": [
        ["ip addr", true],
        ["ip addr show dev eth0", true],
        ["ip -4 addr show", true],
        ["ip addr del x", false],
        ["ip addr 'show' dev eth0", true],
        ["date", true],
        ["date +%F", true],
        ["date 0101", false],
        ["date +%F 0101", false]
      ]
    },
    {
      "_comment": "require_flags — 정확히 있어야 하고, 같은 이름에 값이 붙은 꼴이 하나라도 있으면 불허.",
      "rules": [
        { "exec": "docker", "subcommands": ["stats"], "require_flags": ["--no-stream"] },
        { "exec": "top", "subcommands": [], "require_flags": ["-b"] }
      ],
      "cases": [
        ["docker stats --no-stream", true],
        ["docker stats", false],
        ["docker stats --no-stream=true", false],
        ["docker stats --no-stream --no-stream=false", false],
        ["docker stats --no-str", false],
        ["top -b -n 1", true],
        ["top -bn1", true],
        ["top -n 1", false]
      ]
    },
    {
      "_comment": "같은 exec 의 규칙 여럿은 OR — 하나라도 맞으면 통과.",
      "rules": [
        { "exec": "git", "subcommands": ["status", "log"] },
        { "exec": "git", "subcommands": ["branch"], "max_args": 0 }
      ],
      "cases": [
        ["git status x", true],
        ["git log -p", true],
        ["git branch", true],
        ["git branch x", false],
        ["/usr/bin/git branch", true]
      ]
    },
    {
      "_comment": "sub_first — 서브커맨드는 exec 바로 다음 낱말(앞 플래그의 값이 서브커맨드로 위장하지 못하게). 묶음 규칙은 서브커맨드가 있으면 늘 켜진다.",
      "rules": [{ "exec": "git", "subcommands": ["status"], "sub_first": true }],
      "cases": [
        ["git status", true],
        ["git status -s", true],
        ["git -C status push", false],
        ["git --no-pager status", false],
        ["git 'status'", false],
        ["/usr/bin/git status", true]
      ]
    }
  ],
