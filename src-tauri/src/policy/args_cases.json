  "pipes": {
    "_comment": "파이프 허용(10-22 옵트인 · [automation] allow_pipes). allow = 평탄 패턴(묶음 없음). off = 끔일 때(예전과 같다) · on = 켬일 때. pass = 명령 술어 통과, fail = 사람 승인.",
    "allow": [
      "uptime",
      "cat",
      "ls",
      "ps",
      "sort",
      "head",
      "grep",
      "wc",
      "df",
      "find",
      "awk",
      "echo"
    ],
    "off": {
      "pass": [
        "uptime",
        "uptime && ls",
        "uptime || ls",
        "ls; uptime"
      ],
      "fail": [
        "uptime | cat",
        "ls | sort | head"
      ]
    },
    "on": {
      "pass": [
        "uptime | cat",
        "ls | sort | head",
        "ps aux | grep nginx | wc -l",
        "uptime && ls | head",
        "find /var/log -name x | head",
        "uptime || ls",
        "awk '{print}' x | sort"
      ],
      "fail": [
        "cat x | sh",
        "ls | xargs rm",
        "ps | tee f",
        "ls | sort > f",
        "ls | sort >> f",
        "uptime || ls | cat",
        "ls | cat; uptime",
        "ls; uptime | cat",
        "ls | cat &",
        "ls |& cat",
        "ls | ",
        "| ls",
        "ls | $(echo cat)",
        "ls | cat\nuptime",
        "ls | (cat)",
        "ls | env cat",
        "ls | sudo cat",
        "ls | bash",
        "find . | xargs cat",
        "find . -delete | head",
        "find . -exec cat {} + | head",
        "ls | awk '{system(\"id\")}'",
        "ls | awk '{print | \"sh\"}'",
        "ls | rm -rf x",
        "ls | FOO=1 cat",
        "ls | nohup cat",
        "ls | timeout 5 cat",
        "ls | ssh h cat",
        "ls | python -c x",
        "uptime | mytool"
      ]
    }
  }
